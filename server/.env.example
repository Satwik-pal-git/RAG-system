# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma separated or single origin)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Groq API Key (Place your gsk_... key here)
GROQ_API_KEY=

# Hugging Face API Token (Optional, for higher embedding limits)
HF_API_TOKEN=

# Pinecone Vector Database Configuration
# Create an index with Dimension=384 and Metric=cosine
PINECONE_API_KEY=
PINECONE_INDEX=rag-index
PINECONE_NAMESPACE=

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rag_system?retryWrites=true&w=majority

# Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com